#: ckanext/nice_ui/templates/admin/config.html
#, python-format
msgid "<p><strong>Site Title:</strong> This is the title of this site. It appears in various places throughout the site.</p> <p><strong>Custom Stylesheet:</strong> Define an alternative main CSS file.</p> <p><strong>Site Tag Logo:</strong> This is the logo that appears in the header of every page.</p> <p><strong>About:</strong> This text will appear on this site's <a href=\"%(about_url)s\">about page</a>.</p> <p><strong>Intro Text:</strong> This text will appear on this site's <a href=\"%(home_url)s\">home page</a> as a welcome to visitors.</p> <p><strong>Custom CSS:</strong> This is a block of CSS that appears in <code>&lt;head&gt;</code> tag of every page. If you wish to customize the templates more fully we recommend <a href=\"%(docs_url)s\" target=\"_blank\" rel=\"noreferrer\">reading the documentation</a>.</p>"
msgstr "<p><strong>Lohatenin'ny tranonkala:</strong> Io no lohatenin'ity tranonkala ity. Miseho amin'ny toerana maro ao amin'ny tranonkala izy io.</p> <p><strong>Feuille de style manokana:</strong> Mamaritra rakitra CSS fototra hafa hampiasaina.</p> <p><strong>Logon'ny tranonkala:</strong> Io no logo miseho eo amin'ny lohan'ny pejy rehetra.</p> <p><strong>Mombamomba:</strong> Hiseho ao amin'ny <a href=\"%(about_url)s\">pejy mombamomba</a> an'ity tranonkala ity ity lahatsoratra ity.</p> <p><strong>Lahatsoratra fampahafantarana:</strong> Hiseho ao amin'ny <a href=\"%(home_url)s\">pejy fandraisana</a> an'ity tranonkala ity ity lahatsoratra ity, ho fandraisana ireo mpitsidika.</p> <p><strong>CSS manokana:</strong> Ampahan-kaody CSS ampidirina ao amin'ny tag <code>&lt;head&gt;</code> amin'ny pejy rehetra. Raha te hanamboatra amin'ny antsipiriany kokoa ireo modelin'ny pejy ianao, dia manoro hevitra anao izahay <a href=\"%(docs_url)s\" target=\"_blank\" rel=\"noreferrer\">hamaky ny torolalana</a>.</p>"

#: ckanext/nice_ui/templates/admin/index.html
msgid "Site administration"
msgstr "Fitantanana ny tranonkala"

#: ckanext/nice_ui/templates/admin/index.html
#, python-format
msgid "<p>As a sysadmin user you have full control over this site. Proceed with care!</p> <p>For guidance on using sysadmin features, see the <a href=\"%(docs_url)s\" target=\"_blank\" rel=\"noreferrer\">sysadmin guide</a>.</p>"
